# ── App ───────────────────────────────────────────────────────────────────
APP_KEY=base64:GENERER_AVEC_php_artisan_key_generate
APP_NAME=BizOS
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000

# ── Base de données ───────────────────────────────────────────────────────
DB_ROOT_PASSWORD=rootpassword_a_changer
DB_DATABASE=app_db
DB_USERNAME=app_user
DB_PASSWORD=password_a_changer
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306

# ── URLs ──────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000/api
VITE_STORAGE_URL=http://localhost:8000/storage
FILESYSTEM_DISK=public

# ── Docker Hub (pour production) ────────────────────────────────────────
DOCKER_USERNAME=redamohamedberhouma
BACKEND_IMAGE_TAG=latest
FRONTEND_IMAGE_TAG=latest

# ── Redis (optionnel) ──────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Mail (optionnel) ───────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@bizos.local
MAIL_FROM_NAME="${APP_NAME}"

# ── Services externes (optionnel) ───────────────────────────────────────
SENTRY_LARAVEL_DSN=
BUGSNAG_API_KEY=